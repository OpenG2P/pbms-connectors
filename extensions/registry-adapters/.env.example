# Read by RegisterSettings, two variables per register:
#   REGISTRY_ADAPTERS_<REGISTER>_CONNECTOR          db or dci
#   REGISTRY_ADAPTERS_<REGISTER>_CONNECTION_STRING  decoded by the connector
# db:  postgresql://user:pass@host:5432/dbname (percent-encode the password)
# dci: full search URL, http(s)://host[:port]/dci/sync/search?reg_type=..&reg_record_type=..&timeout=30&ssl_verify=true
#      (all query params optional; reg_type/reg_record_type default per register)
# Leave a register's connection string empty if no program uses it.
# Set the same values on the Celery worker and the staff API.

REGISTRY_ADAPTERS_FARMER_CONNECTOR=db
REGISTRY_ADAPTERS_FARMER_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/socialregistrydb

REGISTRY_ADAPTERS_HOUSEHOLD_CONNECTOR=db
REGISTRY_ADAPTERS_HOUSEHOLD_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/socialregistrydb

REGISTRY_ADAPTERS_DISABILITY_CONNECTOR=dci
REGISTRY_ADAPTERS_DISABILITY_CONNECTION_STRING=http://localhost:8000/dci/sync/search?timeout=30&ssl_verify=true
